{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-protocol.local/schemas/ci_test_reliability_assessment_v1.schema.json",
  "title": "CI Test Reliability Assessment V1",
  "description": "Reliability V1 evidence. The only power design is the repo-static newcombe_wilson_hybrid_exact_binomial_power_v1 definition in $defs; observed evidence may select that identifier but cannot supply or alter design inputs.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "issue_number",
    "pr_number",
    "target_metric",
    "reliability_metrics",
    "sample_identity",
    "confidence_level",
    "non_inferiority_margin",
    "sample_count_rule",
    "non_inferiority_evaluation",
    "workflow_records",
    "playwright_test_cases",
    "sample_provenance",
    "raw_attempts"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "CI_TEST_RELIABILITY_ASSESSMENT_V1"},
    "schema_version": {"const": 1},
    "issue_number": {"type": "integer"},
    "pr_number": {"type": ["integer", "null"]},
    "measured_at": {"type": "string", "minLength": 1, "format": "date-time"},
    "target_metric": {"$ref": "#/$defs/MetricName"},
    "reliability_metrics": {
      "type": "object",
      "required": ["before", "after"],
      "unevaluatedProperties": false,
      "properties": {
        "before": {"$ref": "#/$defs/MetricsBlock"},
        "after": {"$ref": "#/$defs/MetricsBlock"}
      }
    },
    "sample_identity": {
      "type": "object",
      "required": ["key", "required_run_attempt"],
      "unevaluatedProperties": false,
      "properties": {
        "key": {"const": "workflow_run_id"},
        "required_run_attempt": {"const": 1}
      }
    },
    "confidence_level": {"const": 0.95},
    "non_inferiority_margin": {"const": 0.2},
    "sample_count_rule": {"$ref": "#/$defs/SampleCountRule"},
    "non_inferiority_evaluation": {"$ref": "#/$defs/NonInferiorityEvaluation"},
    "workflow_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/WorkflowRecord"}
    },
    "playwright_test_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/PlaywrightTestCase"}
    },
    "sample_provenance": {
      "type": "object",
      "required": ["before", "after"],
      "unevaluatedProperties": false,
      "properties": {
        "before": {"$ref": "#/$defs/ArmProvenance"},
        "after": {"$ref": "#/$defs/ArmProvenance"}
      }
    },
    "raw_attempts": {
      "type": "array",
      "description": "Audit-only retry-attempt records. They are not a statistical sample source and do not contribute to any denominator or classification.",
      "items": {"$ref": "#/$defs/RawAttempt"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "MetricName": {
      "type": "string",
      "enum": [
        "workflow_failure_rate",
        "playwright_flaky_test_rate",
        "playwright_terminal_failure_rate"
      ]
    },
    "Arm": {"type": "string", "enum": ["before", "after"]},
    "PowerDesignId": {"const": "newcombe_wilson_hybrid_exact_binomial_power_v1"},
    "power_designs": {
      "description": "Repo-static design table. This is intentionally a schema definition rather than evidence data, so observed assessments cannot choose inputs post hoc.",
      "type": "object",
      "required": ["newcombe_wilson_hybrid_exact_binomial_power_v1"],
      "unevaluatedProperties": false,
      "properties": {
        "newcombe_wilson_hybrid_exact_binomial_power_v1": {
          "type": "object",
          "required": ["alpha", "target_power", "margin", "assumed_before_rate", "assumed_after_rate", "allocation", "sample_count", "maximum_runs_per_arm", "over_budget"],
          "unevaluatedProperties": false,
          "properties": {
            "alpha": {"const": 0.05},
            "target_power": {"const": 0.8},
            "margin": {"const": 0.2},
            "assumed_before_rate": {"const": 0.05},
            "assumed_after_rate": {"const": 0.05},
            "allocation": {"const": "equal_1_to_1"},
            "sample_count": {"const": "per_arm"},
            "maximum_runs_per_arm": {"const": 100},
            "over_budget": {"const": "design_infeasible"}
          }
        }
      }
    },
    "RateFields": {
      "type": "object",
      "required": ["numerator", "denominator", "rate"],
      "unevaluatedProperties": false,
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "MetricsBlock": {
      "type": "object",
      "required": ["workflow_failure_rate", "playwright_flaky_test_rate", "playwright_terminal_failure_rate"],
      "unevaluatedProperties": false,
      "properties": {
        "workflow_failure_rate": {"$ref": "#/$defs/RateFields"},
        "playwright_flaky_test_rate": {"$ref": "#/$defs/RateFields"},
        "playwright_terminal_failure_rate": {"$ref": "#/$defs/RateFields"}
      }
    },
    "SampleCountRule": {
      "type": "object",
      "required": ["design_id", "required_sample_count_per_arm"],
      "unevaluatedProperties": false,
      "properties": {
        "design_id": {"$ref": "#/$defs/PowerDesignId"},
        "required_sample_count_per_arm": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "NonInferiorityEvaluation": {
      "type": "object",
      "required": ["metric", "effect_measure", "method", "sidedness", "before", "after", "risk_difference", "outcome"],
      "unevaluatedProperties": false,
      "properties": {
        "metric": {"$ref": "#/$defs/MetricName"},
        "effect_measure": {"const": "risk_difference"},
        "method": {"const": "newcombe_wilson_hybrid_mover_v1"},
        "sidedness": {"const": "one_sided"},
        "before": {"$ref": "#/$defs/IntervalEstimate"},
        "after": {"$ref": "#/$defs/IntervalEstimate"},
        "risk_difference": {"$ref": "#/$defs/RiskDifferenceEstimate"},
        "outcome": {"type": "string", "enum": ["non_inferior", "inferior", "inconclusive"]}
      }
    },
    "IntervalEstimate": {
      "type": "object",
      "required": ["numerator", "denominator", "ci_lower", "ci_upper"],
      "unevaluatedProperties": false,
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "ci_lower": {"type": "number", "minimum": 0, "maximum": 1},
        "ci_upper": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "RiskDifferenceEstimate": {
      "type": "object",
      "required": ["method", "point_estimate", "ci_upper"],
      "unevaluatedProperties": false,
      "properties": {
        "method": {"const": "newcombe_wilson_hybrid_mover_v1"},
        "point_estimate": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "ci_upper": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
      }
    },
    "WorkflowRecord": {
      "type": "object",
      "required": ["workflow_run_id", "arm", "run_attempt", "conclusion"],
      "unevaluatedProperties": false,
      "properties": {
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "arm": {"$ref": "#/$defs/Arm"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "conclusion": {"type": "string", "enum": ["success", "failure", "cancelled", "timed_out", "action_required", "skipped"]}
      }
    },
    "PlaywrightTestCase": {
      "type": "object",
      "description": "Official Playwright TestCase.outcome record; retry sequence is not used for the primary classification.",
      "required": ["test_id", "workflow_run_id", "arm", "run_attempt", "outcome"],
      "unevaluatedProperties": false,
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "arm": {"$ref": "#/$defs/Arm"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "outcome": {"type": "string", "enum": ["expected", "flaky", "unexpected", "skipped"]}
      }
    },
    "SampleObservation": {
      "type": "object",
      "required": ["workflow_run_id", "arm", "run_attempt", "classification"],
      "unevaluatedProperties": false,
      "properties": {
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "arm": {"$ref": "#/$defs/Arm"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "classification": {"type": "string", "enum": ["success", "failure", "affected", "not_affected"]}
      }
    },
    "MetricProvenance": {
      "type": "object",
      "required": ["design_id", "observations"],
      "unevaluatedProperties": false,
      "properties": {
        "design_id": {"$ref": "#/$defs/PowerDesignId"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/SampleObservation"}}
      }
    },
    "ArmProvenance": {
      "type": "object",
      "required": ["workflow_failure_rate", "playwright_flaky_test_rate", "playwright_terminal_failure_rate"],
      "unevaluatedProperties": false,
      "properties": {
        "workflow_failure_rate": {"$ref": "#/$defs/MetricProvenance"},
        "playwright_flaky_test_rate": {"$ref": "#/$defs/MetricProvenance"},
        "playwright_terminal_failure_rate": {"$ref": "#/$defs/MetricProvenance"}
      }
    },
    "RawAttempt": {
      "type": "object",
      "required": ["workflow_run_id", "run_attempt", "test_id", "attempt_number", "status"],
      "unevaluatedProperties": false,
      "properties": {
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "test_id": {"type": "string", "minLength": 1},
        "attempt_number": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["passed", "failed", "timedOut", "interrupted", "skipped"]}
      }
    }
  }
}
