{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-protocol.local/schemas/ci_runtime_delta_v2.schema.json",
  "title": "CI Runtime Delta V2",
  "description": "Runtime delta report for a CI performance comparison. mode=comparative requires before/after/delta and forbids budget; mode=absolute requires an after cohort and a budget threshold and forbids before/delta. This is a versioned addition alongside ci_runtime_delta_v1 (templates/runtime-delta.md) and does not replace it.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "issue_number",
    "pr_number",
    "mode",
    "after",
    "outlier_exclusions"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "schema": {
      "const": "ci_runtime_delta_v2"
    },
    "schema_version": {
      "const": 2
    },
    "issue_number": {
      "type": "integer"
    },
    "pr_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "measured_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "comparative",
        "absolute"
      ]
    },
    "before": {
      "$ref": "#/$defs/Cohort"
    },
    "after": {
      "$ref": "#/$defs/Cohort"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "delta": {
      "$ref": "#/$defs/Delta"
    },
    "outlier_exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutlierExclusion"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "comparative"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "before",
          "after",
          "delta"
        ],
        "not": {
          "required": [
            "budget"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "absolute"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "after",
          "budget"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "before"
              ]
            },
            {
              "required": [
                "delta"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "Cohort": {
      "type": "object",
      "required": [
        "job",
        "p50_seconds",
        "p95_seconds",
        "run_ids",
        "run_count",
        "runner_image",
        "workers",
        "scheduler",
        "command_manifest_digest",
        "test_selection_digest"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "p50_seconds": {
          "type": "number",
          "minimum": 0
        },
        "p95_seconds": {
          "type": "number",
          "minimum": 0
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "run_count": {
          "type": "integer",
          "minimum": 0
        },
        "runner_image": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "command_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "test_selection_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunDetail"
          }
        }
      }
    },
    "RunDetail": {
      "type": "object",
      "description": "Per-run raw evidence. Structurally defined but currently unreferenced by the semantic validator (validate_ci_performance_assessment_v2.py does not read run_details or duration_seconds); it is an optional field not listed in Cohort.required. Recomputing P50/P95/delta from these raw samples is a possible future validator extension, not a current enforcement guarantee.",
      "required": [
        "run_id",
        "workflow_run_id",
        "run_attempt",
        "commit_sha",
        "conclusion",
        "duration_seconds"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "conclusion": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "timed_out"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Budget": {
      "type": "object",
      "required": [
        "metric",
        "maximum_value_ms"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "maximum_value_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "Delta": {
      "type": "object",
      "required": [
        "p50_delta_seconds",
        "p95_delta_seconds",
        "p50_improvement_pct",
        "p95_improvement_pct"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "p50_delta_seconds": {
          "type": "number"
        },
        "p95_delta_seconds": {
          "type": "number"
        },
        "p50_improvement_pct": {
          "type": "number"
        },
        "p95_improvement_pct": {
          "type": "number"
        }
      }
    },
    "OutlierExclusion": {
      "type": "object",
      "required": [
        "run_id",
        "reason",
        "rule_id"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
