{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-protocol.local/schemas/agy_permission_boundary_e2e_v1.schema.json",
  "title": "AGY permission-boundary E2E evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "runner", "artifact", "matrix", "attempts", "diagnostic_ledger", "fallback", "failure_taxonomy", "cleanup", "secret_scan"],
  "properties": {
    "schema": {"const": "agy_permission_boundary_e2e/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "exit_code", "actual_agy_executed", "identity_verified", "executable_ref", "executable_version", "binary_digest", "child_returncode", "artifact_digest"],
      "properties": {
        "identity": {"const": "run_agy_permission_boundary_e2e"},
        "exit_code": {"enum": [0, 1, 77]},
        "actual_agy_executed": {"type": "boolean"},
        "identity_verified": {"type": "boolean"},
        "executable_ref": {"type": "string", "pattern": "^[^/]+$"},
        "executable_version": {"type": "string", "minLength": 1},
        "binary_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "child_returncode": {"type": ["integer", "null"]},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["digest"],
      "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "capabilities"],
      "properties": {
        "profile": {"type": "string"},
        "capabilities": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["command", "write", "read", "network", "mcp"]}}
      }
    },
    "attempts": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/attempt"}},
    "diagnostic_ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["pre_invocation_hook_started", "pre_invocation_context_accepted", "injected_step_count", "enforcement_event_count", "pre_tool_use_event_count", "post_tool_use_event_count", "raw_payload_persisted"],
      "properties": {
        "pre_invocation_hook_started": {"type": "boolean"},
        "pre_invocation_context_accepted": {"type": "boolean"},
        "injected_step_count": {"type": "integer", "minimum": 0, "maximum": 5},
        "enforcement_event_count": {"type": "integer", "minimum": 0},
        "pre_tool_use_event_count": {"type": "integer", "minimum": 0},
        "post_tool_use_event_count": {"type": "integer", "minimum": 0},
        "raw_payload_persisted": {"const": false}
      }
    },
    "fallback": {"type": "object", "additionalProperties": false, "required": ["used"], "properties": {"used": {"const": false}}},
    "failure_taxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "completion", "retry"],
      "properties": {"class": {"type": "string"}, "completion": {"type": "boolean"}, "retry": {"type": "string"}}
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["temporary_processes_removed", "loopback_servers_stopped"],
      "properties": {"temporary_processes_removed": {"type": "boolean"}, "loopback_servers_stopped": {"type": "boolean"}}
    },
    "secret_scan": {"type": "object", "additionalProperties": false, "required": ["clean"], "properties": {"clean": {"const": true}}}
  },
  "$defs": {
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["correlation", "predicates"],
      "properties": {
        "correlation": {
          "type": "object", "additionalProperties": false,
          "required": ["run_id", "conversation_id", "step_index", "tool_name", "args_digest", "profile", "capability", "canary_id"],
          "properties": {
            "run_id": {"type": "string", "minLength": 1, "description": "Recorded by the parent runner."},
            "conversation_id": {"type": "string", "minLength": 1, "description": "Captured from live hook payload and validated by parent attempt correlation."},
            "step_index": {"type": "integer", "minimum": 0},
            "tool_name": {"type": "string", "minLength": 1},
            "args_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "profile": {"type": "string", "minLength": 1},
            "capability": {"enum": ["command", "write", "read", "network", "mcp"]},
            "canary_id": {"type": "string", "minLength": 1}
          }
        },
        "predicates": {
          "type": "object", "additionalProperties": false,
          "required": ["deterministic_attempt_present", "pre_tool_use_present", "explicit_deny", "post_tool_use_absent", "side_effect_invariant"],
          "properties": {
            "deterministic_attempt_present": {"type": "boolean"},
            "pre_tool_use_present": {"type": "boolean"},
            "explicit_deny": {"type": "boolean"},
            "post_tool_use_absent": {"type": "boolean"},
            "side_effect_invariant": {"type": "boolean"}
          }
        }
      }
    }
  }
}
