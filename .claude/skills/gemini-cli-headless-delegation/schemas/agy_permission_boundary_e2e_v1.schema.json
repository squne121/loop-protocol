{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-protocol.local/schemas/agy_permission_boundary_e2e_v1.schema.json",
  "title": "AGY permission-boundary E2E evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "runner",
    "artifact",
    "matrix",
    "attempts",
    "diagnostic_ledger",
    "fallback",
    "failure_taxonomy",
    "cleanup",
    "secret_scan"
  ],
  "properties": {
    "schema": {
      "const": "agy_permission_boundary_e2e/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "exit_code",
        "actual_agy_executed",
        "identity_verified",
        "executable_ref",
        "executable_version",
        "binary_digest",
        "child_returncode",
        "artifact_digest"
      ],
      "properties": {
        "identity": {
          "const": "run_agy_permission_boundary_e2e"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            77,
            78
          ]
        },
        "actual_agy_executed": {
          "type": "boolean"
        },
        "identity_verified": {
          "type": "boolean"
        },
        "executable_ref": {
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "executable_version": {
          "type": "string",
          "minLength": 1
        },
        "binary_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binary_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "realpath_class",
            "realpath_digest",
            "sha256",
            "size",
            "mtime_ns",
            "platform",
            "arch"
          ],
          "properties": {
            "realpath_class": {
              "description": "Issue #1979 fix_delta (P1-3): a generalized/classified form of the resolved binary path (e.g. `$HOME/.local/bin/agy` or just the basename) -- never the raw absolute realpath, so the artifact never discloses the host username/home layout.",
              "type": [
                "string",
                "null"
              ]
            },
            "realpath_digest": {
              "description": "Issue #1979 fix_delta (P1-3): a hash of the actual raw realpath, enabling exact-match/drift comparison without disclosing the path itself.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mtime_ns": {
              "type": [
                "integer",
                "null"
              ]
            },
            "platform": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          }
        },
        "child_returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "capabilities"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "write",
              "read",
              "network"
            ]
          }
        },
        "tool_inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "diagnostic_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_invocation_hook_started",
        "pre_invocation_context_accepted",
        "injected_step_count",
        "enforcement_event_count",
        "pre_tool_use_event_count",
        "post_tool_use_event_count",
        "raw_payload_persisted"
      ],
      "properties": {
        "pre_invocation_hook_started": {
          "type": "boolean"
        },
        "pre_invocation_context_accepted": {
          "type": "boolean"
        },
        "injected_step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "enforcement_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "pre_tool_use_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "post_tool_use_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_payload_persisted": {
          "const": false
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "const": false
        }
      }
    },
    "failure_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "completion",
        "retry"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "completion": {
          "type": "boolean"
        },
        "retry": {
          "type": "string"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_processes_removed",
        "loopback_servers_stopped"
      ],
      "properties": {
        "temporary_processes_removed": {
          "type": "boolean"
        },
        "loopback_servers_stopped": {
          "type": "boolean"
        },
        "process_group_isolated": {
          "type": "boolean",
          "description": "Issue #1979 AC7: distinct from directory cleanup -- whether the invocation ran in its own OS process group."
        },
        "descendant_processes_absent": {
          "type": "boolean",
          "description": "Issue #1979 AC7: whether no process remains in that process group after the run."
        },
        "temporary_tree_removal": {
          "description": "Issue #1997: optional v1 additive temporary-tree removal ledger. New producers emit it for every run so artifacts record whether retry was observation-only or enabled; it never contains raw paths or filenames.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_result",
            "initial_exception_type",
            "initial_errno",
            "initial_errno_name",
            "initial_operation",
            "path_class",
            "relative_path_digest",
            "residual_observation",
            "retry_policy_mode",
            "retry_eligible",
            "retry_count",
            "retry_result",
            "final_cleanup_verdict",
            "postcondition_absent",
            "producer_contract_revision"
          ],
          "properties": {
            "producer_contract_revision": {
              "type": "string",
              "description": "Issue #1997 fix_delta P2-2: identifies which producer contract revision emitted this ledger, so a legacy pre-fix_delta artifact (lacking this field entirely, since the whole object remains optional) can never be confused with a current producer's output.",
              "minLength": 1
            },
            "initial_result": {"enum": ["success", "failure"]},
            "initial_exception_type": {"type": ["string", "null"]},
            "initial_errno": {"type": ["integer", "null"]},
            "initial_errno_name": {"type": ["string", "null"]},
            "initial_operation": {"type": ["string", "null"], "enum": ["rmdir", "unlink", "remove", "lstat", "rmtree", "unknown", null]},
            "path_class": {"type": ["string", "null"], "enum": ["root", "descendant", "unknown", null]},
            "relative_path_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "residual_observation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "entry_count", "holder_status"],
              "properties": {
                "status": {"enum": ["not_run", "complete", "unsupported", "error"]},
                "entry_count": {"type": ["integer", "null"], "minimum": 0},
                "holder_status": {"enum": ["not_checked", "absent", "busy", "unsupported", "error"]}
              }
            },
            "retry_policy_mode": {"enum": ["observation_only", "single_retry_enabled"]},
            "retry_eligible": {"type": "boolean"},
            "retry_count": {"enum": [0, 1]},
            "retry_result": {"enum": ["not_run", "success", "failure"]},
            "final_cleanup_verdict": {"enum": ["removed", "failed"]},
            "postcondition_absent": {"type": "boolean"}
          },
          "allOf": [
            {
              "description": "Issue #1997 fix_delta P1-1 (OWNER review issuecomment-5307195963): postcondition_absent and final_cleanup_verdict must be a schema-enforced bidirectional equivalence, not just a Python-validator check.",
              "if": {"properties": {"postcondition_absent": {"const": true}}, "required": ["postcondition_absent"]},
              "then": {"properties": {"final_cleanup_verdict": {"const": "removed"}}}
            },
            {
              "if": {"properties": {"postcondition_absent": {"const": false}}, "required": ["postcondition_absent"]},
              "then": {"properties": {"final_cleanup_verdict": {"const": "failed"}}}
            }
          ]
        }
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean"
      ],
      "properties": {
        "clean": {
          "const": true
        }
      }
    },
    "capability_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_predicate",
        "predicate_kind",
        "status",
        "reason_code",
        "evidence_source"
      ],
      "properties": {
        "bootstrap_predicate": {
          "type": "string",
          "minLength": 1
        },
        "predicate_kind": {
          "enum": [
            "bootstrap_prerequisite",
            "claim_under_test"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unavailable",
            "inconclusive",
            "evidence_invalid"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "type": "string",
          "minLength": 1
        },
        "preflight_status": {
          "description": "Issue #1979 fix_delta (P0-2): additive, optional. The original static bootstrap-preflight `status` (e.g. `inconclusive`), preserved unchanged when `status` is later promoted after a genuine live-run observation, so the two are never conflated.",
          "enum": [
            "supported",
            "unsupported",
            "unavailable",
            "inconclusive",
            "evidence_invalid"
          ]
        },
        "observed_status": {
          "description": "Issue #1979 fix_delta (P0-2): additive, optional. Present only when a live run reached genuine completion (all capabilities prompt-compliant, allow/deny judged correctly) -- always `supported` when present.",
          "const": "supported"
        },
        "observation_digest": {
          "description": "Issue #1979 fix_delta (P0-2): additive, optional. A digest binding the `observed_status` promotion to this run's actual attempt evidence.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completion_blocker",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unsupported_by_design"
        },
        "completion_blocker": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "counterpart_role",
        "counterpart_digest",
        "bound"
      ],
      "properties": {
        "role": {
          "enum": [
            "allow",
            "deny",
            "n/a"
          ]
        },
        "counterpart_role": {
          "enum": [
            "allow",
            "deny",
            "n/a"
          ]
        },
        "counterpart_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "type": "boolean"
        }
      }
    },
    "attempt_method": {
      "description": "Issue #1979 AC6/AC8: additive, optional. Fixed value -- the only tool-call-elicitation method this runner implements for live mode.",
      "enum": [
        "ephemeral_message_prompt"
      ]
    },
    "prompt_compliance": {
      "description": "Issue #1979 AC6/AC8: additive, optional. Per-capability ephemeralMessage bounded-retry compliance record. Empty for hermetic mode / non-live non-completion paths that never attempted ephemeralMessage injection.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempts",
          "compliant"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "compliant": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation",
        "expectation",
        "predicates"
      ],
      "properties": {
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "conversation_id",
            "step_index",
            "tool_name",
            "args_digest",
            "profile",
            "capability",
            "canary_id"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "description": "Recorded by the parent runner."
            },
            "conversation_id": {
              "type": "string",
              "minLength": 1,
              "description": "Captured from live hook payload and validated by parent attempt correlation."
            },
            "step_index": {
              "type": "integer",
              "minimum": 0
            },
            "tool_name": {
              "type": "string",
              "minLength": 1
            },
            "args_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "enum": [
                "command",
                "write",
                "read",
                "network"
              ]
            },
            "canary_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expectation": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "deny_post_tool_use_characterization": {
          "description": "Issue #1979: additive, optional. Present when this attempt has been observed by `_attempts_from_parent_observation` -- characterizes a deny-expectation attempt's PostToolUse activity (if any) rather than treating any PostToolUse occurrence on deny as a fixed mismatch. `applicable` is false for allow-expectation attempts (vacuous default values).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicable",
            "observed",
            "correlated",
            "secret_scan_passed"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "observed": {
              "type": "boolean"
            },
            "correlated": {
              "type": "boolean"
            },
            "secret_scan_passed": {
              "type": "boolean"
            }
          }
        },
        "predicates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic_attempt_present",
            "pre_tool_use_present",
            "decision_matches_expectation",
            "post_tool_use_matches_expectation",
            "side_effect_matches_expectation",
            "same_attempt_correlation",
            "logger_failure_absent"
          ],
          "properties": {
            "deterministic_attempt_present": {
              "type": "boolean"
            },
            "pre_tool_use_present": {
              "type": "boolean"
            },
            "decision_matches_expectation": {
              "type": "boolean"
            },
            "post_tool_use_matches_expectation": {
              "type": "boolean"
            },
            "side_effect_matches_expectation": {
              "type": "boolean"
            },
            "same_attempt_correlation": {
              "type": "boolean"
            },
            "logger_failure_absent": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
