{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefinementPreflightResultV1",
  "description": "Output schema for run_refinement_preflight.py result artifact. Strict: additionalProperties false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "issue_number",
    "repo",
    "planner_exit_code",
    "planner_fail_closed",
    "next_action",
    "must_read",
    "do_not_read",
    "commands",
    "blockers",
    "artifacts",
    "hashes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "refinement_preflight_result/v1",
      "description": "Schema version sentinel."
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "needs_fix",
        "blocked",
        "environment_failure"
      ],
      "description": "Wrapper-level status after applying exit_code_mapping table."
    },
    "issue_number": {
      "type": "integer",
      "description": "GitHub Issue number."
    },
    "repo": {
      "type": "string",
      "description": "owner/repo string."
    },
    "planner_exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Exit code returned by plan_refinement_loop.py. Null if planner was not invoked."
    },
    "planner_fail_closed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Value of plan.fail_closed.required from planner output. Null if planner was not invoked."
    },
    "next_action": {
      "type": "string",
      "description": "Suggested next action for the orchestrator (e.g. 'proceed', 'human_judgment_required', 'fix_environment')."
    },
    "must_read": {
      "type": "array",
      "description": "Files/paths the orchestrator must read before proceeding.",
      "items": {
        "type": "string"
      }
    },
    "do_not_read": {
      "type": "array",
      "description": "Files/paths the orchestrator must not read to conserve context.",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "description": "Suggested commands. Each item must use argv array only (no shell strings).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "argv",
          "shell",
          "source"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Command kind (e.g. 'run_planner', 'validate_schema')."
          },
          "argv": {
            "type": "array",
            "description": "Argument vector. Must not contain shell-interpolated strings.",
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "type": "boolean",
            "const": false,
            "description": "Always false. Shell execution is prohibited."
          },
          "source": {
            "type": "string",
            "description": "Origin of this command template.",
            "enum": [
              "static_wrapper_template",
              "registry"
            ]
          }
        }
      }
    },
    "planner_fail_closed_reason_codes": {
      "type": "array",
      "description": "Planner fail_closed reason codes mirrored for schema-safe forwarding.",
      "items": {
        "type": "string"
      }
    },
    "required_sections": {
      "type": "array",
      "description": "Sections required by FAIL_CLOSED_REWRITE_CONSTRAINTS_V1.required_sections (planner-derived).",
      "items": {
        "type": "string"
      }
    },
    "required_contract_keys": {
      "type": "array",
      "description": "Contract keys required by FAIL_CLOSED_REWRITE_CONSTRAINTS_V1.required_contract_keys (planner-derived).",
      "items": {
        "type": "string"
      }
    },
    "rewrite_constraints": {
      "type": "object",
      "description": "Planner fail_closed rewrite constraints mirrored for artifact/compact passthrough.",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "required_sections",
        "required_contract_keys",
        "rewrite_constraints",
        "override_policy",
        "max_rewrite_attempts",
        "no_progress_route"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "FAIL_CLOSED_REWRITE_CONSTRAINTS_V1"
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_contract_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rewrite_constraints": {
          "type": "object",
          "required": [
            "must_add_sections",
            "must_add_contract_keys",
            "freeform_rewrite_forbidden"
          ],
          "additionalProperties": false,
          "properties": {
            "must_add_sections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "must_add_contract_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "freeform_rewrite_forbidden": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "override_policy": {
          "type": "object",
          "required": [
            "allowed_reason_codes",
            "never_override_reason_codes",
            "overridable_in_current_result",
            "non_overridable_in_current_result"
          ],
          "additionalProperties": false,
          "properties": {
            "allowed_reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "missing_required_section",
                  "missing_required_contract_key"
                ]
              }
            },
            "never_override_reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "unknown_issue_kind",
                  "issue_kind_policy_load_error",
                  "contract_schema_parse_error",
                  "template_resolution_error",
                  "checker_internal_error"
                ]
              }
            },
            "overridable_in_current_result": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "missing_required_section",
                  "missing_required_contract_key"
                ]
              }
            },
            "non_overridable_in_current_result": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "unknown_issue_kind",
                  "issue_kind_policy_load_error",
                  "contract_schema_parse_error",
                  "template_resolution_error",
                  "checker_internal_error",
                  "malformed_machine_readable_contract",
                  "unknown_input_schema",
                  "planner_internal_error",
                  "missing_required_parent_section",
                  "template_required_sections_unavailable"
                ]
              }
            }
          }
        },
        "max_rewrite_attempts": {
          "type": "integer"
        },
        "no_progress_route": {
          "type": "string"
        }
      }
    },
    "blockers": {
      "type": "array",
      "description": "Blocker reason codes (e.g. 'ANCHOR_NOT_IN_ISSUE').",
      "items": {
        "type": "string"
      }
    },
    "contract_update": {
      "type": "object",
      "description": "Optional bounded handoff emitted only by contract_update.run.with_anchor. It contains no Issue body or raw anchor text.",
      "additionalProperties": false,
      "required": [
        "status",
        "writes",
        "iterations",
        "final_readback",
        "fresh_preflight",
        "fresh_review",
        "fresh_readiness"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "no_change",
            "rebased",
            "failed",
            "handoff_required"
          ]
        },
        "disposition": {
          "description": "PR #2057 OWNER review P1-3: echoes the single canonical scope-reframe classifier's disposition (decide_rewrite_route.classify_scope_reframe_disposition). null when the mutation attempt predates that classification (pre-#2048 non-scope-reframe callers).",
          "enum": [
            "patch",
            "proven_no_change",
            "full_rewrite_required",
            "invalid",
            null
          ]
        },
        "reason_code": {
          "description": "Present only for disposition full_rewrite_required / invalid; the classifier's reason_code.",
          "type": "string"
        },
        "writes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "final_readback": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "not_applicable"
          ]
        },
        "fresh_preflight": {
          "type": "string"
        },
        "fresh_review": {
          "type": "string"
        },
        "fresh_readiness": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Paths to artifact files written by this wrapper.",
      "additionalProperties": false,
      "properties": {
        "raw_issue_snapshot": {
          "type": "string",
          "description": "Path to raw_issue_snapshot.json"
        },
        "planner_input": {
          "type": "string",
          "description": "Path to planner_input.json"
        },
        "refinement_preflight_result_v1": {
          "type": "string",
          "description": "Path to refinement_preflight_result_v1.json"
        },
        "repair_diagnostics": {
          "type": "string",
          "description": "Path to repair_diagnostics.json (Issue #2016 iteration-3 P1-1; present when status: needs_fix)."
        },
        "repair_candidate_body": {
          "type": "string",
          "description": "Path to repaired_issue_body.md, the auto_apply_safe candidate body (Issue #2016 iteration-3 P1-1; present when status: needs_fix)."
        }
      }
    },
    "hashes": {
      "type": "object",
      "description": "SHA256 hashes of key artifacts for byte-stability verification.",
      "additionalProperties": false,
      "properties": {
        "raw_issue_snapshot_sha256": {
          "type": "string",
          "description": "SHA256 of canonical JSON of raw_issue_snapshot."
        },
        "planner_input_sha256": {
          "type": "string",
          "description": "SHA256 of canonical JSON of planner_input."
        },
        "result_core_sha256": {
          "type": "string",
          "description": "SHA256 of canonical JSON of result core fields (excl. artifacts, hashes). When status: needs_fix, also binds a stable environment-independent projection of repair_action (schema_version, policy_version, disposition, original/repaired body SHA, repair_kinds, reason_codes -- excluding absolute artifact paths) under result_core.repair_action_core (Issue #2016 iteration-3 P1-2)."
        }
      }
    },
    "repair_action": {
      "type": "object",
      "description": "Versioned repair_action disposition projection (Issue #2016). Present only when status == needs_fix (disposition: auto_apply_safe). Mirrors the producer repair_action contract (repair_issue_contract_result_v1.schema.json) with wrapper-owned diagnostics_artifact / candidate_body_artifact paths filled in.",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "disposition",
        "original_body_sha256",
        "repaired_body_sha256",
        "diagnostics_artifact",
        "candidate_body_artifact",
        "repair_kinds",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "repair_action/v1"
        },
        "policy_version": {
          "type": "string",
          "const": "deterministic-issue-repair/v1"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "auto_apply_safe",
            "human_review_required",
            "informational",
            "invalid_payload"
          ]
        },
        "original_body_sha256": {
          "type": "string"
        },
        "repaired_body_sha256": {
          "type": "string"
        },
        "diagnostics_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_body_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "repair_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "planner_fail_closed": {
            "const": true
          }
        },
        "required": [
          "planner_fail_closed"
        ]
      },
      "then": {
        "required": [
          "planner_fail_closed_reason_codes",
          "required_sections",
          "required_contract_keys",
          "rewrite_constraints"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_fix"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "repair_action",
          "artifacts"
        ],
        "properties": {
          "repair_action": {
            "type": "object",
            "required": [
              "disposition",
              "diagnostics_artifact",
              "candidate_body_artifact"
            ],
            "properties": {
              "disposition": {
                "const": "auto_apply_safe"
              },
              "diagnostics_artifact": {
                "type": "string"
              },
              "candidate_body_artifact": {
                "type": "string"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "required": [
              "repair_diagnostics",
              "repair_candidate_body"
            ],
            "properties": {
              "repair_diagnostics": {
                "type": "string"
              },
              "repair_candidate_body": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
