{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCOPE_DELTA_CONSUMPTION_RECEIPT_V1",
  "description": "Immutable receipt produced by the controlled consumer (run_refinement_preflight.py --consume-authority-transport) after verifying the router receipt digest, performing at most one mutation, a readback, and a fresh rerun. #2053.",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "issue_number",
    "git_head_sha",
    "generated_at",
    "router_receipt_path",
    "transport_payload_sha256",
    "consumed_payload_sha256",
    "mutation_applied",
    "readback_verified",
    "fresh_rerun_performed",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "SCOPE_DELTA_CONSUMPTION_RECEIPT_V1"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "git_head_sha": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "router_receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport_payload_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "consumed_payload_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "mutation_applied": {
      "type": "boolean"
    },
    "readback_verified": {
      "type": "boolean"
    },
    "fresh_rerun_performed": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "environment_failure"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "missing_file",
        "malformed_json",
        "digest_mismatch",
        "wrong_issue",
        "wrong_git_head",
        "wrong_invocation_id",
        "stale_previous_invocation",
        "write_failure",
        "router_receipt_not_ok",
        "fresh_rerun_route_drift",
        "fresh_rerun_error",
        null
      ]
    }
  }
}
