{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairIssueContractResultV1",
  "description": "Output schema for repair_issue_contract.py (schema: repair_issue_contract/v1). Documents the versioned repair_action disposition contract consumed by run_refinement_preflight.py (Issue #2016).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "repair_issue_contract/v1"
    },
    "dry_run": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "original_body_sha256": {
      "type": "string"
    },
    "repaired_body_sha256": {
      "type": "string"
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "line_start",
          "line_end",
          "reason",
          "original",
          "repaired"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "line_start": {
            "type": "integer"
          },
          "line_end": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "repaired": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "unknown"
            ]
          }
        }
      }
    },
    "repair_action": {
      "type": "object",
      "description": "Versioned, closed-enum classification of all repairs[] records. confidence alone is not an authorization signal; disposition is the single source of truth consumed by downstream wrappers.",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "disposition",
        "original_body_sha256",
        "repaired_body_sha256",
        "diagnostics_artifact",
        "candidate_body_artifact",
        "repair_kinds",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "repair_action/v1"
        },
        "policy_version": {
          "type": "string",
          "const": "deterministic-issue-repair/v1"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "auto_apply_safe",
            "human_review_required",
            "informational",
            "invalid_payload"
          ]
        },
        "original_body_sha256": {
          "type": "string"
        },
        "repaired_body_sha256": {
          "type": "string"
        },
        "diagnostics_artifact": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absolute path to a persisted diagnostics artifact, if any. Null when the producer itself did not persist one (the wrapper persists its own copy)."
        },
        "candidate_body_artifact": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absolute path to the repaired body written by --apply/--out-file. Null in dry-run mode."
        },
        "repair_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unique mutating repair kinds observed across repairs[] (informational-only kinds excluded)."
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "auto_apply_safe"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "repair_kinds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "string",
      "description": "Present only on CLI-level failure (body_file_not_found, body_read_error, repair_error). repair_action is absent in that case."
    }
  },
  "anyOf": [
    {
      "required": [
        "schema",
        "dry_run",
        "changed",
        "original_body_sha256",
        "repaired_body_sha256",
        "repairs",
        "repair_action"
      ]
    },
    {
      "required": [
        "schema",
        "error"
      ]
    }
  ]
}
