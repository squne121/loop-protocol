{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loop-protocol.internal/schemas/agent-retrospective/observer_result_v1.schema.json",
  "title": "observer_result/v1",
  "description": "Canonical wire-contract schema for the claude CLI --json-schema flag when invoking retrospective-runtime-observer (and other agent-retrospective observer leaves). Mirrors run_retrospective.py's EvidenceBundle dataclass (WIRE_SCHEMA_EVIDENCE_BUNDLE = \"observer_result/v1\", Issue #2301). Only a public-safe evidence_ref string is carried -- no field for raw payload/stdout/stderr/absolute paths/credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "base_sha",
    "source_set_digest",
    "observer_id",
    "evidence_ref",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "observer_result/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "minLength": 1
    },
    "source_set_digest": {
      "type": "string",
      "minLength": 1
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claim",
          "claim_class"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "claim_class": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
